# ========================================================
# Farzi RestaurantOS Pro — Environment Configuration
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication (generate 32+ byte secure random secret in production)
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_32_BYTES_RANDOM_SECRET_KEY
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-restaurant-domain.vercel.app

# Public Frontend Deployment URL (used for table QR code generation)
VITE_PUBLIC_APP_URL=http://localhost:5173

# Spring Boot & MySQL Database (when running Java backend on Render/Railway)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=restaurantos
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Cloudinary Image Storage (Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
